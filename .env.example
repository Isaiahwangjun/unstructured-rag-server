# Copy to .env and fill in. Only OPENAI_API_KEY is required.
OPENAI_API_KEY=

# Optional: point at an OpenAI-compatible gateway (Azure OpenAI,
# LiteLLM, internal AI gateway, etc.). Leave unset to hit OpenAI
# directly.
# OPENAI_BASE_URL=https://your-gateway.example.com/v1

# Optional overrides — defaults shown.
# CHROMA_DIR=./.chroma
# COLLECTION=rag_kit
# EMBED_MODEL=text-embedding-3-small
# MCP_HOST=127.0.0.1
# MCP_PORT=8765
